# --- Database (auto-added by Vercel when you connect Neon in the Storage tab) ---
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Email notifications (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=approach.faizan@gmail.com
# Optional once you verify a domain in Resend:
# CONTACT_FROM_EMAIL=Portfolio <contact@yourdomain.com>

# --- Inbox at /admin.html (pick a long random string) ---
ADMIN_TOKEN=change-me-to-a-long-random-string
# Max messages per visitor (per IP) per hour. Default 30. Use 0 for no limit.
# RATE_LIMIT_PER_HOUR=30
# Optional random string used to hash visitor IPs for rate limiting
# IP_SALT=another-random-string
